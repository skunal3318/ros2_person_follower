<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>four_web_dashboard</name>
  <version>0.0.0</version>
  <description>Browser dashboard (Three.js + roslibjs over rosbridge) for the four_rover person-follower: live 3D pose from odometry, annotated camera feed, and manual drive controls.</description>
  <maintainer email="kunal780954@gmail.com">kunal-jazzy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
